<?xml version="1.0" encoding="UTF-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GuitarApp.Maui.Views" 
    x:Class="GuitarApp.Maui.AppShell" 
    Shell.FlyoutBehavior="Disabled"
>
    <TabBar>
        <Tab Title="Accordeur">
            <ShellContent ContentTemplate="{DataTemplate views:MainView}" />
        </Tab>
        <Tab Title="Historique">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryView}" />
        </Tab>
    </TabBar>
</Shell>