<controls:PageBase 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GuitarApp.Maui.Controls"
    xmlns:viewmodels="clr-namespace:GuitarApp.Core.ViewModels;assembly=GuitarApp.Core"
    xmlns:models="clr-namespace:GuitarApp.Core.Models;assembly=GuitarApp.Core"
    x:Class="GuitarApp.Maui.Views.MainView"
    x:DataType="viewmodels:MainViewModel"
    Title="{Binding Title}"
>

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="15">
        <VerticalStackLayout Grid.Row="0" Spacing="12" HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Source :" VerticalOptions="Center"/>
                <Picker ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}" WidthRequest="180"/>
            </HorizontalStackLayout>

            <Frame BorderColor="{Binding TuningIndicatorColor}" CornerRadius="12" Padding="15" WidthRequest="330" HasShadow="True">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding StatusMessage}" TextColor="{Binding TuningIndicatorColor}" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <!-- Aiguille native GPU ultra-stable anti-obsolescence -->
                    <Grid HeightRequest="120" WidthRequest="290" HorizontalOptions="Center">
                        <BoxView Color="LightGray" HeightRequest="2" VerticalOptions="End" Margin="0,0,0,10"/>
                        <BoxView Color="#2B7A4B" HeightRequest="4" WidthRequest="35" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,9"/>
                        <BoxView Color="{Binding TuningIndicatorColor}" WidthRequest="4" HeightRequest="95" VerticalOptions="End" HorizontalOptions="Center" AnchorY="1.0" Margin="0,0,0,10" Rotation="{Binding CentsError}"/>
                        <Ellipse Fill="{Binding TuningIndicatorColor}" WidthRequest="10" HeightRequest="10" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,5"/>
                    </Grid>

                    <Label Text="{Binding DetectedNote}" FontSize="44" FontAttributes="Bold" TextColor="{Binding TuningIndicatorColor}" HorizontalOptions="Center" Margin="0,-5,0,0"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Label Text="{Binding CurrentFrequency, StringFormat='{0} Hz'}" TextColor="DimGray"/>
                        <Label Text="{Binding CentsError, StringFormat='{0} cts'}" FontAttributes="Bold" TextColor="{Binding TuningIndicatorColor}"/>
                    </HorizontalStackLayout>

                    <!-- Oscilloscope dynamique vectoriel régulé -->
                    <GraphicsView x:Name="WaveformCanvas" HeightRequest="50" WidthRequest="290" HorizontalOptions="Center">
                        <GraphicsView.Drawable>
                            <controls:WaveformDrawable Samples="{Binding WaveformBuffer}" StrokeColor="{Binding TuningIndicatorColor}" />
                        </GraphicsView.Drawable>
                    </GraphicsView>

                    <Label Text="{Binding DetectedChordNotes}" FontSize="20" FontAttributes="Bold" TextColor="DarkSlateGray" HorizontalOptions="Center" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>
            <Button Text="{Binding ActionButtonText}" Command="{Binding ToggleListeningCommand}" BackgroundColor="DarkSlateGray" TextColor="White" WidthRequest="240" HeightRequest="45" CornerRadius="22"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding LiveSessionNotes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DetectedNoteLog">
                    <Border StrokeShape="RoundRectangle 6" Margin="0,2" Padding="8" Stroke="LightGray">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="{Binding NoteName}" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding Frequency, StringFormat='{0} Hz'}" TextColor="Gray"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</controls:PageBase>